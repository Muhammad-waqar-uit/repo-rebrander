# repo-rebrander configuration. Copy to .env and fill in, or pass flags on CLI.
# All values are optional — CLI flags and --github-user/--name/--email override these.

# GitHub account that will own the new repos.
GITHUB_USER=your-github-username

# Author name written into every rewritten commit.
COMMITTER_NAME=Your Name

# Author email written into every rewritten commit.
COMMITTER_EMAIL=you@example.com

# Directory containing the local repos to rebrand.
BASE_DIR=C:\path\to\repos

# Comma-separated repo folder names. Leave empty to pass --repos on the CLI.
REPOS=